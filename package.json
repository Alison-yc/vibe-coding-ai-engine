{
  "name": "ai-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地优先的 AI 全栈实验项目：RAG 知识库对话、可视化工作流编排、本地文件 Agent。模型全部跑在本机 Ollama。",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev:server": "pnpm --filter liangzui-ai-server start:dev",
    "dev:web": "pnpm --filter liangzui-ai-web dev",
    "dev:app": "pnpm --filter liangzui-ai-app tauri dev",
    "dev:db": "docker compose -f docker/docker-compose.yml up -d --wait",
    "dev:db:stop": "docker compose -f docker/docker-compose.yml stop",
    "dev:db:reset": "docker compose -f docker/docker-compose.yml down -v && pnpm dev:db && pnpm db:migrate",
    "build": "turbo run build",
    "clean": "turbo run clean && rimraf coverage .turbo",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run build && vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "turbo run build && vitest run --coverage",
    "test:integration": "vitest run --project server -t integration",
    "test:e2e": "playwright test",
    "test:security": "vitest run --dir e2e/security",
    "db:generate": "pnpm --filter liangzui-ai-server db:generate",
    "db:migrate": "pnpm --filter liangzui-ai-server db:migrate",
    "db:studio": "pnpm --filter liangzui-ai-server db:studio",
    "baseline": "tsx scripts/model-baseline/index.ts",
    "rag-eval": "tsx scripts/rag-eval/index.ts",
    "gen-tests": "tsx scripts/gen-tests/index.ts",
    "gen-tests:verify": "tsx scripts/gen-tests/verify.ts",
    "gen-tests:mutate": "tsx scripts/gen-tests/mutate.ts",
    "sec:sast:test": "cp .semgrep.yml tests/semgrep/rules.yml && semgrep --test tests/semgrep",
    "sec:sast": "pnpm sec:sast:test && semgrep --config .semgrep.yml --config p/typescript --config p/nodejs --config p/react --config p/secrets --error --sarif -o semgrep.sarif .",
    "sec:sca": "bash scripts/sec-sca.sh",
    "sec:secrets": "gitleaks detect --source . --no-banner --redact --verbose",
    "sec:all": "pnpm sec:sast && pnpm sec:sca && pnpm sec:secrets",
    "tauri": "pnpm --filter liangzui-ai-app tauri",
    "tauri:build": "pnpm --filter liangzui-ai-app tauri build",
    "ci:local": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:cov && pnpm sec:sast && pnpm sec:sca && pnpm build",
    "ci:local:full": "pnpm dev:db && pnpm ci:local && pnpm test:integration",
    "prepare": "husky"
  },
  "devDependencies": {
    "@ai-engine/eslint-config": "workspace:*",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
