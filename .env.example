# ─────────────────────────────────────────────────────────────
# 复制为 .env 后按需修改。.env 不入库。
# 端口约定见 .plan/01-architecture-overview.md，改动请同步文档。
# ─────────────────────────────────────────────────────────────

# ── Ollama（本机已运行的模型服务） ──────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 对话与工具调用主模型
OLLAMA_MODEL=qwen3.5:2b
# 长上下文/复杂推理备选（7.2GB，加载慢，不做默认）
OLLAMA_MODEL_LARGE=gemma4:e2b
# 向量化模型，768 维
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# 以下三项的默认值必须来自 plan 04 的基线测评报告，不要凭感觉填。
# 现有代码里的 numCtx=2048 / numPredict=128 是拍脑袋的值，RAG 场景下会截断输出。
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
OLLAMA_TEMPERATURE=0.2
OLLAMA_KEEP_ALIVE=10m

# ── PostgreSQL + pgvector（docker compose 启动） ────────────────
POSTGRES_USER=ai_engine
POSTGRES_PASSWORD=ai_engine_dev_only
POSTGRES_DB=ai_engine
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ai_engine:ai_engine_dev_only@localhost:5432/ai_engine

# ── NestJS 服务端 ──────────────────────────────────────────────
SERVER_PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ── 前端 ───────────────────────────────────────────────────────
# Web 端的后端基址。桌面端不读这个，从应用设置页的持久化配置读。
VITE_API_BASE_URL=http://localhost:3000
# 开发服务器端口写死在各壳的 vite 配置里，不要改成「先找个空端口」：
#   Web 壳  5173（frontend/liangzui-ai-web，plan 12 建）
#   Tauri 壳 1420（clients/liangzui-ai-app，已配 strictPort）

# ── Agent 文件操作 ─────────────────────────────────────────────
# 允许 Agent 访问的根目录白名单（冒号分隔）。留空表示禁用文件工具。
# 路径沙箱会确保所有操作不越出这些目录，见 .plan/10。
AGENT_WORKSPACE_ROOTS=

# ── 工作流 code 节点沙箱 ───────────────────────────────────────
WORKFLOW_CODE_TIMEOUT_MS=3000
WORKFLOW_CODE_MAX_OUTPUT_BYTES=65536
