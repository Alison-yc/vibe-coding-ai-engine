{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "liangzui-ai-app",
  "version": "0.1.0",
  "identifier": "com.liangzui.liangzui-ai-app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm prepare:sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Liangzui AI",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "externalBin": ["binaries/node"],
    "resources": {
      "sidecar/server": "sidecar/server",
      "resources/sidecar.env.example": "sidecar.env.example"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
