{
  "mcpServers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "<YOUR_PATH>"],
      "enabled": false,
      "timeout": 30000,
      "flattenNames": true,
      "toolFilter": {
        "include": ["read_file", "write_file", "list_directory"]
      },
      "toolPermissions": {
        "read_file": { "kind": "read", "resourceParam": "path" },
        "write_file": { "kind": "write", "resourceParam": "path" },
        "list_directory": { "kind": "read", "resourceParam": "path" }
      }
    },
    "weather": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@dangahagan/weather-mcp@1.25.6"],
      "enabled": false,
      "timeout": 60000,
      "flattenNames": true,
      "toolFilter": {
        "include": ["get_weather_summary"],
        "inputParams": {
          "get_weather_summary": ["city_name"]
        },
        "requiredParams": {
          "get_weather_summary": ["city_name"]
        },
        "fixedParams": {
          "get_weather_summary": { "units": "metric" }
        }
      },
      "toolPermissions": {
        "get_weather_summary": { "kind": "execute" }
      }
    }
  }
}
